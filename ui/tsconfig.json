{
	"extends": "$app/tsconfig",
	"include": ["src", "*"],
	"exclude": ["src/service-worker", "src/service-worker.ts"],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"paths": { "#lib": ["./src/lib"], "#lib/*": ["./src/lib/*"] }
	}
}
