# Copy to .env and fill in. Every OWNHEALTH_* variable also accepts a *_FILE twin
# (for example OWNHEALTH_SECRET_KEY_FILE=/run/secrets/secret_key), which wins.

# Password of the owner role `ownhealth`: Postgres and the one-shot admin service (migrations,
# backups, restores). Generate one: openssl rand -base64 32
OWNHEALTH_DB_PASSWORD=
# Password of the app's own database role `ownhealth_app` (no table owner). Generate one: openssl rand -base64 32
OWNHEALTH_APP_DB_PASSWORD=
# Signs sessions and pagination cursors. Generate one: openssl rand -base64 48
OWNHEALTH_SECRET_KEY=
# The URL people open, used for passkeys and links (no trailing slash).
OWNHEALTH_BASE_URL=http://localhost:8080
# Host port the app listens on (bound to 127.0.0.1; put a reverse proxy in front).
OWNHEALTH_HTTP_PORT=8080
# es or en.
OWNHEALTH_DEFAULT_LOCALE=es

# Auto-accept threshold for imported rows (never below 0.90).
# OWNHEALTH_AUTO_ACCEPT_THRESHOLD=0.95
# Age of majority for the minor rule.
# OWNHEALTH_AGE_OF_MAJORITY=18
# Background job workers in the app process.
# OWNHEALTH_JOB_WORKERS=2

# Demo: seed the synthetic Rivera family once at startup. Never on a real install.
# OWNHEALTH_DEMO=1
# Dev only: unauthenticated requests act as the first owner. Never on a real install.
# OWNHEALTH_DEV_AUTH=1

# Inboxes (v0.2). Encrypts the secrets OwnHealth keeps for its inboxes (IMAP password, Paperless
# token, PDF passwords) with AES-256-GCM: 32 random bytes, base64. Generate one: openssl rand -base64 32
# Without it, inboxes that need a secret cannot be saved. Keep it with your backups: a restore with
# another key asks you to re-enter those secrets.
# OWNHEALTH_SECRETS_KEY=
# OCR for scans and photos (only the `ocr` image variant carries the models). Off: scans wait as
# pending documents for an agent or a person. Turn on both lines together: the first starts the `ocr`
# worker (compose.yaml), the second sends unread pages to it.
# COMPOSE_PROFILES=ocr
# OWNHEALTH_OCR=1
# OWNHEALTH_OCR_MODELS_DIR=/opt/ownhealth/ocr-models
# Watched folder: files dropped here (one subfolder per profile) are imported.
# OWNHEALTH_INBOX_DIR=/inbox
