# Python (maintainer scripts, the MCP client contract)
__pycache__/
*.py[cod]

# UI
ui/node_modules/
ui/.svelte-kit/
# Built UI: produced by `pnpm build` and the Docker image, never committed
server/static/

# Rust
server/target/
server/vendor/

# Runtime data and secrets. data/ holds the shipped reference files; a server started from the repo
# root or server/ keeps its own files in ./data, which stay out of git.
/data/*
!/data/calculators/
!/data/family/
!/data/genome-facts/
!/data/genome/
!/data/prevention/
!/data/rules/
!/data/summary/
!/data/terminology/
!/data/vendors/
server/data/
.env

# Scratch notes between parallel build lanes
.lanes/
